{
  "name": "panindigan-automate",
  "version": "0.1.2",
  "description": "Facebook Messenger automation for personal accounts over HTTP and MQTT, written from scratch in strict TypeScript.",
  "keywords": [
    "facebook",
    "messenger",
    "bot",
    "automation",
    "mqtt",
    "chatbot",
    "facebook-messenger"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest bench",
    "prepublishOnly": "node build.mjs"
  },
  "dependencies": {
    "lru-cache": "^11.0.0",
    "mqtt": "^5.10.0",
    "pino": "^9.4.0",
    "socks": "^2.8.6",
    "tough-cookie": "^5.0.0",
    "undici": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
