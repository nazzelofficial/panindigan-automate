{
  "name": "panindigan-automate",
  "version": "0.2.4",
  "description": "Facebook Messenger automation for personal accounts over HTTP and MQTT, written from scratch in strict TypeScript.",
  "keywords": [
    "facebook",
    "messenger",
    "bot",
    "automation",
    "mqtt",
    "chatbot",
    "facebook-messenger",
    "messenger-bot",
    "chat-automation",
    "bun",
    "typescript",
    "node26"
  ],
  "author": {
    "name": "Nazzel",
    "url": "https://github.com/nazzelofficial"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  },
  "packageManager": "pnpm@12.21.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazzelofficial/panindigan-automate.git"
  },
  "bin": {
    "panindigan-automate": "./bin/panindigan-automate.mjs"
  },
  "bugs": {
    "url": "https://github.com/nazzelofficial/panindigan-automate/issues"
  },
  "homepage": "https://github.com/nazzelofficial/panindigan-automate#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "bin",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest bench",
    "prepublishOnly": "node build.mjs"
  },
  "dependencies": {
    "lru-cache": "^11.5.3",
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "socks": "^2.8.10",
    "tough-cookie": "^6.1.0",
    "undici": "^8.12.4",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.14",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
